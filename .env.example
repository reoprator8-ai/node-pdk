PDK_AUTH_STRATEGY=clientauth
PDK_CLIENT_ID=your-client-id
PDK_CLIENT_SECRET=your-client-secret
PDK_ISSUER=https://accounts.pdk.io
PDK_SCOPE=openid offline_access
# Required for unattended userauth deployments; omit to launch the browser flow.
PDK_REFRESH_TOKEN=
PDK_API_BASE_URL=https://accounts.pdk.io/api/
PDK_STREAM_TIMEOUT_MS=10000
